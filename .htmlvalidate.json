{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "no-inline-style": "off",
    "svg-focusable": "off",
    "prefer-native-element": "off",
    "no-implicit-button-type": "error",
    "wcag/h30": "error",
    "wcag/h37": "error",
    "wcag/h63": "error",
    "wcag/h67": "error",
    "element-required-attributes": "error",
    "attribute-boolean-style": "off",
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "long-title": "off",
    "attr-quotes": "off",
    "no-raw-characters": "off"
  }
}