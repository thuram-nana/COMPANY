{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/systems/vigil/index.html",
        "http://localhost/systems/recor/index.html",
        "http://localhost/doctrine/index.html",
        "http://localhost/trust/index.html",
        "http://localhost/contact/index.html",
        "http://localhost/fr/index.html"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.98 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:best-practices": ["error", { "minScore": 1.0 }],
        "categories:seo": ["error", { "minScore": 1.0 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1200 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 300000 }]
      }
    }
  }
}
