# Caddy configuration for a SIGIL-controlled origin (a static origin behind
# Cloudflare). Serves dist/ with HTTP/3, compression, the full security header
# set, and long-cache fonts. The same policy lives in public/.htaccess
# (Apache/LiteSpeed — the Namecheap host) and public/_headers (Cloudflare Pages);
# the build fails if the CSP hash drifts between the three.
#
# Usage: caddy run --config deploy/Caddyfile
# Point the site root at the built dist/ directory.

(security_headers) {
	header {
		# Hash of the exact inline <head> script text (see deploy/README.md §7)
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; script-src 'self' 'sha256-KP7L7cim+yAsJHmXibDh8BpaZhSAsch1lM1rxIBb9yc='; connect-src 'self'; form-action 'self' mailto:; manifest-src 'self'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

sigilsovereign.com {
	root * /srv/sigilsovereign/dist
	encode zstd gzip
	import security_headers

	# fonts never change (self-hosted IBM Plex subsets)
	@fonts {
		path /fonts/* *.woff2
	}
	header @fonts Cache-Control "public, max-age=31536000, immutable"

	# app.css / app.js / briefing.js are not content-hashed: revalidate (cheap 304)
	@code {
		path /styles/* *.js
	}
	header @code Cache-Control "public, max-age=3600, stale-while-revalidate=86400"

	# correct content types for machine files
	@plain {
		path /.well-known/security.txt /llms.txt /llms-full.txt
	}
	header @plain Content-Type "text/plain; charset=utf-8"
	@feed {
		path /feed.xml
	}
	header @feed Content-Type "application/atom+xml; charset=utf-8"

	# pretty URLs: /systems/vigil/ -> /systems/vigil/index.html
	try_files {path} {path}/index.html {path}/ =404
	file_server

	# the built 404 pages (French for /fr/*), with the same headers
	handle_errors {
		@404 expression {http.error.status_code} == 404
		@404fr {
			expression {http.error.status_code} == 404
			path /fr/*
		}
		import security_headers
		rewrite @404fr /fr/404.html
		rewrite @404 /404.html
		file_server
	}
}

# www -> apex
www.sigilsovereign.com {
	redir https://sigilsovereign.com{uri} permanent
}
