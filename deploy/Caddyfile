# Caddy configuration for a SIGIL-controlled origin (the recommended hosting
# posture: a static origin behind Cloudflare). Serves dist/ with HTTP/3, Brotli,
# the full security header set, and long-cache immutable assets.
#
# Usage: caddy run --config deploy/Caddyfile
# Point the site root at the built dist/ directory.

sigilsovereign.com {
	root * /srv/sigilsovereign/dist
	encode zstd gzip
	file_server

	# --- security headers (mirror public/_headers) ---
	header {
		# Replace the hash if you edit the inline <head> script (see deploy/README.md)
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self' 'sha256-Er+vLp5IAuSeKg60tNDrLeE+lBaJbEnzs75ajoyekIM='; connect-src 'self'; form-action 'self' mailto:; manifest-src 'self'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# immutable hashed assets
	@static {
		path /fonts/* /styles/* *.js *.woff2
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# correct content types for machine files
	@plain {
		path /.well-known/security.txt /llms.txt /llms-full.txt
	}
	header @plain Content-Type "text/plain; charset=utf-8"

	# pretty URLs: /systems/vigil/ -> /systems/vigil/index.html (file_server handles this)
	try_files {path} {path}/index.html {path}/ =404
}

# www -> apex
www.sigilsovereign.com {
	redir https://sigilsovereign.com{uri} permanent
}
